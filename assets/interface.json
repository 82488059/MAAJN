{
    // 本文件主要定义了通用 UI 的行为和显示内容
    // 可参考文档和示例添加更多您需要的功能
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    // 示例：https://github.com/MaaXYZ/MaaFramework/blob/main/sample/interface.json
    "interface_version": 2,
    "name": "MaaJNBJ",
    "description": "这是一个使用 MaaFramework 创建的新项目。",
    "contact": "QQ群: 123456789",
    "license": "MIT",
    "welcome": "首次使用！欢迎使用 MAA!",
    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/MaaXYZ/MaaPracticeBoilerplate",
    "version": "1.0.0",
    // Mirror酱为第三方分发服务，新项目默认关闭
    // 若有需要请联系 Mirror酱 开通，直接自行开启是无法使用的
    // "mirrorchyan_rid": "MaaXXX",
    // "mirrorchyan_multiplatform": true,
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720 // 默认缩放分辨率的短边长度
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "./agent/main.py"
        ]
    },
    "task": [
        {
            "name": "无限水井",
            "entry": "无限水井"
        },
        {
            "name": "修改为地基模式",
            "entry": "修改为地基模式"
        },
        {
            "name": "无限集英",
            "entry": "无限集英"
        },
        {
            "name": "无限太极",
            "entry": "无限太极"
        },
        {
            "name": "自动买药",
            "entry": "自动买药",
            "description": "角色站在 NPC 温无双旁边。先打开百业货运。生活杂物入口卡上的数量不是 0 时，先把原料存进仓库（草药和枯茱萸留下），再回来买药。否则直接买。清河和开封买草药，胡牛儿买枯茱萸。不点仓库取出。三家都买成后关货运，停在驻地主界面；离开百业由一条龙入口调用。",
            "option": [
                "买药数量",
                "存放失败时"
            ]
        },
        {
            "name": "买药炼药一条龙",
            "entry": "买药炼药一条龙",
            "description": "站在温无双旁。先跑自动买药（必要时存放），三家买成关货运后由本任务锚点接离开百业→炼药→买钱袋→返回驻地→找温无双。未买齐不离开、不炼药。寻到人后不点对话。",
            "option": [
                "买药数量",
                "存放失败时"
            ]
        },
        {
            "name": "炼药",
            "entry": "炼药",
            "description": "角色已退出百业，屏幕上有「炼药」对话。点开后选逍遥散，按体力与材料上限循环炼到不能再炼，再退出界面。退出后续买钱袋。需要 Agent。"
        },
        {
            "name": "买钱袋",
            "entry": "买钱袋",
            "description": "主界面打开菜单→不肝→商店：体力≥200 买金丝宋元钱袋，否则跳过；再赛季追赶物资栏买一贯宋元通宝最大数量，返回主界面。代币不够视为成功。需要 Agent。"
        },
        {
            "name": "离开百业",
            "entry": "离开百业",
            "description": "人在百业驻地主界面（货运已关，右上有退出）。认「退出」文字并点上方门形图标，有确认再点，等加载出右上主菜单；离开后若出活动宣传则关叉再等。加载最多约 120 秒。"
        },
        {
            "name": "返回百业",
            "entry": "返回百业",
            "description": "主界面→菜单→百业→(可能过场)→右下返回驻地→确定→等加载结束（右上出现退出，与离开百业同一按钮，只认不点）。"
        },
        {
            "name": "找温无双",
            "entry": "找温无双",
            "description": "返回驻地后，人在门口、脸朝正房。先点按唤起摇杆，再推满按住朝前 10 秒过院子和水渠，门口往右进正房直到右侧出现「温无双」。只走不点。落点或镜头变了会走偏。"
        },
        {
            "name": "存放原料",
            "entry": "存放原料",
            "description": "打开包裹，筛选原料，先解开锁着的仓库页签，再解锁格子并把原料存进仓库。草药和枯茱萸留在背包。也可以在包裹或仓库已经打开时直接开始。当前页满了就换下一页。",
            "option": [
                "存放失败时"
            ]
        }
    ],
    "option": {
        "买药数量": {
            "type": "select",
            "label": "购买数量",
            "description": "草药和枯茱萸共用。默认买满（点最大）。测试可改买 1 个。",
            "default_case": "买满",
            "cases": [
                {
                    "name": "买1个",
                    "label": "买 1 个（测试）",
                    "description": "不点最大按钮。数量不是 1 时用减号或输入调到 1，并关掉数字键盘。调不到就放弃这家店，不盲点购买。",
                    "pipeline_override": {
                        "买药_设定数量": {
                            "next": [
                                "买药_确保数量为1"
                            ],
                            "on_error": [
                                "买药_输入数量1",
                                "买药_放弃本店"
                            ]
                        }
                    }
                },
                {
                    "name": "买满",
                    "label": "买满",
                    "description": "点数量栏右侧的最大按钮。点完核对数量：大于 1 就买；仍是 1 会再点一次，还是 1 也买这 1 个。钱不够时，能补足就点确认，补不足就取消并换下一家。",
                    "pipeline_override": {
                        "买药_设定数量": {
                            "next": [
                                "买药_点击最大"
                            ],
                            "on_error": [
                                "买药_点击最大坐标"
                            ],
                            "timeout": 3000
                        }
                    }
                }
            ]
        },
        "存放失败时": {
            "type": "select",
            "label": "失败时",
            "description": "出错之后怎么收场。默认点返回回到主界面，再让任务失败。测试时可以停在当前画面，方便看卡在哪。",
            "default_case": "回主界面",
            "cases": [
                {
                    "name": "回主界面",
                    "label": "回到主界面",
                    "description": "走存放_准备失败退出，点右上角返回直到认出主菜单，然后任务失败。",
                    "pipeline_override": {
                        "存放_失败时": {
                            "next": [
                                "存放_准备失败退出"
                            ]
                        }
                    }
                },
                {
                    "name": "停在原地",
                    "label": "停在原地（测试）",
                    "description": "不点返回，不跑退出循环。人留在当前画面，任务失败。",
                    "pipeline_override": {
                        "存放_失败时": {
                            "next": [
                                "存放_停在原地"
                            ]
                        }
                    }
                }
            ]
        }
    }
}