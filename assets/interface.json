{
    // 本文件主要定义了通用 UI 的行为和显示内容
    // 可参考文档和示例添加更多您需要的功能
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    // 示例：https://github.com/MaaXYZ/MaaFramework/blob/main/sample/interface.json
    "interface_version": 2,
    "name": "MaaJNBJ",
    "description": "这是一个使用 MaaFramework 创建的新项目。",
    "contact": "QQ群: 123456789",
    "license": "MIT",
    "welcome": "首次使用！欢迎使用 MAA!",
    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/MaaXYZ/MaaPracticeBoilerplate",
    "version": "1.0.0",
    // Mirror酱为第三方分发服务，新项目默认关闭
    // 若有需要请联系 Mirror酱 开通，直接自行开启是无法使用的
    // "mirrorchyan_rid": "MaaXXX",
    // "mirrorchyan_multiplatform": true,
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720 // 默认缩放分辨率的短边长度
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    // 可选的 agent 示例
    // "agent": {
    //     "child_exec": "python",
    //     "child_args": [
    //         "./agent/main.py"
    //     ]
    // },
    "task": [
        {
            "name": "无限水井",
            "entry": "无限水井"
        },
        {
            "name": "修改为地基模式",
            "entry": "修改为地基模式"
        },
        {
            "name": "无限集英",
            "entry": "无限集英"
        },
        {
            "name": "无限太极",
            "entry": "无限太极"
        },
        {
            "name": "自动买药",
            "entry": "自动买药",
            "description": "角色站在 NPC 温无双旁边。打开百业货运，清河和开封生活杂物商店买草药，再去胡牛儿动使杂货买枯茱萸。结束后停在百业货运界面。",
            "option": [
                "买药数量"
            ]
        }
    ],
    "option": {
        "买药数量": {
            "type": "select",
            "label": "购买数量",
            "description": "草药和枯茱萸共用。默认买 1 个。买满会点数量栏右侧的最大按钮。",
            "default_case": "买1个",
            "cases": [
                {
                    "name": "买1个",
                    "label": "买 1 个（测试）",
                    "description": "不点最大按钮。数量不是 1 时用减号或输入调到 1。调不到就放弃这家店，不盲点购买。",
                    "pipeline_override": {
                        "买药_设定数量": {
                            "next": [
                                "买药_确保数量为1"
                            ],
                            "on_error": [
                                "买药_输入数量1",
                                "买药_放弃本店"
                            ]
                        }
                    }
                },
                {
                    "name": "买满",
                    "label": "买满",
                    "description": "点击数量栏右侧的最大按钮后再购买。钱不够时，能补足就点确认，补不足就取消并换下一家。",
                    "pipeline_override": {
                        "买药_设定数量": {
                            "next": [
                                "买药_点击最大"
                            ],
                            "on_error": [
                                "买药_点击最大坐标"
                            ],
                            "timeout": 3000
                        }
                    }
                }
            ]
        }
    }
}