{
    "存放原料": {
        "attach": {
            "description": "入口。人可以在主界面，也可以已经打开包裹或仓库。把原料存进仓库，草药和枯茱萸留在背包"
        },
        "recognition": "DirectHit",
        "action": "DoNothing",
        "anchor": {
            "存放_离开后": "存放_结束",
            "存放_草药入口": "存放_取消草药",
            "存放_草药复核": "存放_复核"
        },
        "next": [
            "存放_从屏幕开始"
        ],
        "timeout": 4000,
        "on_error": [
            "存放_直接失败"
        ]
    },
    "存放_从屏幕开始": {
        "attach": {
            "description": "已经在包裹或仓库里就接着做，不用再点主菜单。两边都没有才去点菜单"
        },
        "recognition": "DirectHit",
        "action": "DoNothing",
        "next": [
            "存放_屏上有道具",
            "存放_屏上有仓库"
        ],
        "timeout": 1200,
        "rate_limit": 250,
        "on_error": [
            "存放_点主菜单"
        ]
    },
    "存放_屏上有道具": {
        "attach": {
            "description": "包裹已开：旧版标题「道具」，或页签「普通道具」（OCR 常成「普通道」）。ROI 盖到页签行，避开只扫到顶栏引导气泡"
        },
        "recognition": "OCR",
        "expected": [
            "道具",
            "普通道",
            "普通道具"
        ],
        "roi": [
            780,
            0,
            420,
            150
        ],
        "threshold": 0.5,
        "action": "DoNothing",
        "next": [
            "存放_看仓库引导"
        ]
