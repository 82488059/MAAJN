    "炼药_读体力": {
        "attach": {
            "description": "仅供自定义动作。右栏臂力图标旁 当前总体力/单份需要（如 1000/15，中间可有空格）。ROI 约 y=515–565，勿扫顶栏、勿偏低到材料格"
        },
        "recognition": "OCR",
        "expected": [
            "\\d[\\d,，]*\\s*[/／]\\s*\\d+"
        ],
        "roi": [
            980,
            515,
            280,
            50
        ],
        "threshold": 0.3
    },
    "炼药_读数量": {
        "attach": {
            "description": "仅供自定义动作。数量选择框 当前/上限（如 1/98）"
