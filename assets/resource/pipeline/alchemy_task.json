    "炼药_算量并输入": {
        "attach": {
            "description": "Custom：OCR 体力与上限，算 min(floor(总÷15),上限)。可炼≥2 才输入并提交；可炼=1 按材料耗尽走退出界面；OCR 失败走安全退出点返回，勿与 next 提交互相 error loop"
        },
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "炼药_算量并输入",
        "custom_action_param": {
            "cost": 15
        },
        "post_delay": 200,
        "next": [
            "炼药_点提交"
        ],
        "timeout": 8000,
        "on_error": [
            "炼药_安全退出点返回",
            "炼药_结束失败"
        ]
    },
