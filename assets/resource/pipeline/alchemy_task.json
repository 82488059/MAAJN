{
    "炼药": {
        "attach": {
            "description": "入口。假定已退出百业且有炼药对话。timeout 15 秒盖住离开后对话晚出。认不到对话走结束失败（勿经安全退出模板，主界面无返回箭头会 error loop）。需 Agent"
        },
        "recognition": "DirectHit",
        "action": "DoNothing",
        "next": [
            "炼药_点对话"
        ],
        "timeout": 15000,
        "rate_limit": 400,
        "on_error": [
            "炼药_结束失败"
        ]
    },
    "炼药_点对话": {
        "attach": {
            "description": "点炉旁对话条「炼药」。ROI 略放宽以适配离开后落点偏移；仍避开右下技能键"
        },
        "recognition": "OCR",
        "expected": "炼药",
        "roi": [
            620,
            280,
            400,
            280
        ],
        "threshold": 0.45,
        "action": "Click",
        "post_delay": 600,
        "max_hit": 3,
        "next": [
            "炼药_点逍遥散"
        ],
        "timeout": 8000,
        "on_error": [
