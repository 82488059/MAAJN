    "天工_读数量": {
        "attach": {
            "description": "仅供自定义动作。数量选择框 当前/上限（如 1/100）。ROI 宽于炼药，天工页 y≈528"
        },
        "recognition": "OCR",
        "expected": [
            "\\d+\\s*[/／]\\s*\\d+",
            "\\d+/\\d+"
        ],
        "roi": [
            1000,
            500,
            220,
            60
        ],
        "threshold": 0.25
    },
    "天工_点最大": {
        "attach": {
            "description": "仅供自定义动作 TemplateMatch。数量栏右侧「最大」图标，禁止盲点坐标"
