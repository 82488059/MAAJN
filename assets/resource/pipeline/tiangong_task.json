{
    "自动天工": {
        "attach": {
            "description": "入口。已在天工页则直接合成；已开炼药页则点天工道具；否则点对话。多选目标由 checkbox 合并进天工_开始多选队列"
        },
        "recognition": "DirectHit",
        "action": "DoNothing",
        "next": [
            "天工_已在天工页",
            "天工_已开界面",
            "天工_点对话"
        ],
        "timeout": 3000,
        "rate_limit": 400,
        "on_error": [
            "自动天工_结束失败"
        ]
    },
    "天工_已在天工页": {
        "attach": {
            "description": "右栏已有「数量选择」或「需要材料」：天工界面已打开，不再点对话/分类，直接进合成路由"
        },
        "recognition": "OCR",
        "expected": [
            "数量选择",
            "需要材料"
        ],
        "roi": [
            700,
            200,
            560,
            400
        ],
        "threshold": 0.4,
        "action": "DoNothing",
        "post_delay": 200,
        "next": [
            "天工_合成路由"
        ],
        "timeout": 1200,
        "rate_limit": 300,
        "on_error": [
            "天工_已开界面"
        ]
    },
    "天工_已开界面": {
        "attach": {
            "description": "顶栏有「天工道具」或「药剂」：炼药界面已开，跳过对话，再点分类"
        },
        "recognition": "OCR",
        "expected": [
            "天工道具",
            "药剂"
        ],
        "roi": [
            0,
            0,
            420,
            90
        ],
        "threshold": 0.4,
        "action": "DoNothing",
        "post_delay": 200,
        "next": [
            "天工_点天工道具"
        ],
        "timeout": 1500,
        "rate_limit": 300,
        "on_error": [
            "天工_点对话"
        ]
    },
    "天工_点对话": {
        "attach": {
            "description": "点炉旁「炼药」或「点火」。ROI 对齐炼药_点对话"
        },
        "recognition": "OCR",
        "expected": [
            "炼药",
            "点火"
        ],
        "roi": [
            480,
            180,
            560,
            420
        ],
        "threshold": 0.4,
        "action": "Click",
        "post_delay": 800,
        "max_hit": 5,
        "next": [
            "天工_点天工道具"
        ],
        "timeout": 12000,
        "on_error": [
            "自动天工_结束失败"
        ]
    },
    "天工_点天工道具": {
        "attach": {
            "description": "左上分类点「天工道具」，只点一次"
        },
        "recognition": "OCR",
        "expected": "天工道具",
        "roi": [
            0,
            0,
            420,
            100
        ],
        "threshold": 0.45,
        "action": "Click",
        "post_delay": 600,
        "max_hit": 1,
        "next": [
            "天工_合成路由"
        ],
        "timeout": 5000,
        "on_error": [
            "自动天工_结束失败"
        ]
    },
    "天工_合成路由": {
        "attach": {
            "description": "进入多选队列。checkbox 各 case 的 override 合并到天工_开始多选队列.custom_action_param"
        },
        "recognition": "DirectHit",
        "action": "DoNothing",
        "next": [
            "天工_开始多选队列"
        ],
        "timeout": 1000
    },
    "天工_开始多选队列": {
        "attach": {
            "description": "Custom：读各 天工_勾选_* enabled 建队列（避免 custom_action_param 整段被替换只剩最后一项）"
        },
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "天工_开始多选队列",
        "custom_action_param": {},
        "post_delay": 100,
        "next": [
            "天工_找并点配方"
        ],
        "timeout": 5000,
        "on_error": [
            "自动天工_结束失败"
        ]
    },
    "天工_找并点配方": {
        "attach": {
            "description": "Custom：找当前配方；已在详情或点中后若材料不足→队列下一项直到最后一项，禁止为缺材料再翻页"
        },
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "天工_找并点配方",
        "post_delay": 100,
        "next": [
            "天工_算量并输入"
        ],
        "timeout": 90000,
        "on_error": [
            "天工_队列下一项"
        ]
    },
    "天工_队列下一项": {
        "attach": {
            "description": "Custom：当前材料炼完/找不到/不可合成后推进队列；空则退出界面"
        },
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "天工_队列下一项",
        "post_delay": 100,
        "next": [
            "天工_找并点配方"
        ],
        "timeout": 5000,
        "on_error": [
            "天工_退出界面"
        ]
    },
    "天工_点配方": {
        "attach": {
            "description": "仅供自定义动作 OCR。expected 由 Agent 覆盖。不作为流水线翻页入口"
        },
        "recognition": "OCR",
        "expected": [
            "^淬火油$",
            "^淬水蜡$",
            "^淬毒散$",
            "积火脂·三级",
            "积水蜡·三级",
            "积毒锭·三级"
        ],
        "roi": [
            20,
            90,
            680,
            560
        ],
        "threshold": 0.4
    },
    "天工_读标题": {
        "attach": {
            "description": "仅供自定义动作。右侧详情标题；已选中当前配方时禁止再翻列表"
        },
        "recognition": "OCR",
        "expected": [
            "^淬火油$",
            "^淬水蜡$",
            "^淬毒散$",
