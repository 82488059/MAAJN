        "attach": {
            "description": "已在百业子系统页（技艺/首页等），右下能认到「返回驻地」。勿再走功能菜单点「百业」（会误点百业日志）"
        },
        "recognition": "OCR",
        "expected": [
            "返回驻地",
            "回驻地"
        ],
        "roi": [
            1040,
            620,
            230,
            90
        ],
        "threshold": 0.4,
        "action": "DoNothing",
        "post_delay": 200,
        "next": [
