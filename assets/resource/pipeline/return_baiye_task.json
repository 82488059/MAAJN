{
    "返回百业": {
        "attach": {
            "description": "入口。先关登录礼浮层。主界面→主菜单→百业→(可能过场)→右下返回驻地→确定→等加载结束（右上出现退出）。已在百业页（见返回驻地）则直接点返回。结束后走锚点回百业_结束后，未设置则停在门口"
        },
        "recognition": "DirectHit",
        "action": "DoNothing",
        "next": [
            "回百业_已在驻地",
            "回百业_已见返回驻地",
            "回百业_已开功能菜单",
            "回百业_点主菜单"
        ],
        "timeout": 3000,
        "on_error": [
            "回百业_结束失败"
        ]
    },
