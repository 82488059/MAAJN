        "attach": {
            "description": "离开确认 OCR 失败时点金色确认中心 (1082, 475)。点完同样先等加载，再认主菜单"
        },
        "recognition": "DirectHit",
        "action": "Click",
        "target": [
            1082,
            475
        ],
        "post_delay": 800,
        "max_hit": 1,
