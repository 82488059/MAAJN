    "离开百业_结束": {
        "attach": {
            "description": "已到主菜单。单独跑离开百业时停在这里；买药和一条龙改走锚点离开百业_结束后"
        },
        "recognition": "DirectHit",
        "action": "DoNothing",
        "next": []
