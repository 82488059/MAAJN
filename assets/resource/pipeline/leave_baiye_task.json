        "timeout": 5000,
        "on_error": [
            "离开百业_结束失败"
        ]
    },
    "离百业_先等加载": {
        "attach": {
            "description": "退出和确认都点完后先空等 10 秒，再找右上主菜单。过场开头会闪出菜单，立刻认会在加载图上进炼药。timeout 130 秒含这 10 秒，剩下的时间等主菜单；加载有时超过 1 分钟"
        },
        "recognition": "DirectHit",
        "action": "DoNothing",
        "post_delay": 10000,
        "next": [
            "离百业_等主菜单"
        ],
        "timeout": 130000,
        "rate_limit": 500,
        "on_error": [
            "离开百业_结束失败"
        ]
    },
    "离百业_等主菜单": {
        "attach": {
            "description": "离开加载结束：右上出现主菜单。命中后还要确认已经没有「退出」，退出还在就继续等"
        },
        "recognition": "TemplateMatch",
        "template": "storage/主菜单.png",
        "roi": [
            1080,
            0,
            200,
            90
        ],
        "threshold": 0.85,
        "action": "DoNothing",
        "post_delay": 400,
        "next": [
            "离百业_确认无退出"
        ],
        "timeout": 120000,
        "rate_limit": 500,
        "on_error": [
            "离开百业_结束失败"
        ]
    },
    "离百业_确认无退出": {
        "attach": {
            "description": "主菜单已经出现，再取反确认右上没有「退出」。驻地和确认弹窗上还有退出，不能当成已经离开。通过后走锚点离开百业_结束后"
        },
        "recognition": "OCR",
        "expected": "退出",
        "roi": [
            1000,
            0,
            280,
            70
