{
    "离开百业": {
        "attach": {
            "description": "入口。人已在百业驻地主界面（货运已关，右上有退出）。点退出，有确认再点，等加载出右上主菜单。可单独跑；买药关货运后也会进来。结束后走锚点离开百业_结束后，未设置则停"
        },
        "recognition": "DirectHit",
        "action": "DoNothing",
        "next": [
            "离百业_点退出"
        ],
        "timeout": 3000,
        "on_error": [
            "离百业_点退出坐标"
        ]
    },
    "离百业_点退出": {
        "attach": {
            "description": "驻地主界面右上「退出」（与返回百业等加载同一按钮，这里要点下去）。点完只等确认弹窗，不要立刻认主菜单"
        },
        "recognition": "OCR",
        "expected": "退出",
        "roi": [
            1000,
            0,
            280,
            70
        ],
        "threshold": 0.5,
        "action": "Click",
        "post_delay": 600,
        "max_hit": 2,
        "next": [
            "离百业_点确认"
        ],
        "timeout": 8000,
        "on_error": [
            "离百业_点退出坐标"
        ]
    },
    "离百业_点退出坐标": {
        "attach": {
            "description": "退出 OCR 失败时点右上 (1120, 36)。点完只等确认弹窗"
        },
        "recognition": "DirectHit",
        "action": "Click",
        "target": [
            1120,
            36
        ],
        "post_delay": 600,
        "max_hit": 2,
        "next": [
            "离百业_点确认"
        ],
        "timeout": 8000,
        "on_error": [
