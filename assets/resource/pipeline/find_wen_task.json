{
    "找温无双": {
        "attach": {
            "description": "入口。返回驻地后人在门口、脸朝正房。先点按唤起左侧摇杆，再朝前按住 10 秒过院子和水渠，往右进正房直到右侧「温无双」。只走不点。可单独跑"
        },
        "recognition": "DirectHit",
        "action": "DoNothing",
        "next": [
            "找温_唤起摇杆"
        ],
        "timeout": 3000,
        "on_error": [
            "找温无双_结束失败"
        ]
    },
